{
  "expo": {
    "name": "Skycast",
    "slug": "skycast",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "skycast",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#03c75a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skycast.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Skycast uses your location to pick the nearest region for weather alerts.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.skycast.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#03c75a"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "skycast",
              "host": "region"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#03c75a",
          "defaultChannel": "weather-alerts",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skycast uses your location to pick the nearest region for weather alerts.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-splash-screen",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}

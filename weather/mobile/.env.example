# Base URL of the Skycast backend (weather/backend). Defaults to http://localhost:8787/api/v1.
# On an Android emulator use http://10.0.2.2:8787/api/v1; on a physical device use your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8787/api/v1

# Set to 1 to serve bundled fixtures instead of calling the backend (no server needed).
EXPO_PUBLIC_USE_FIXTURES=0
